# Copy to .env and fill in. Nothing here is required to run the tests —
# the test suite uses RAG_PROVIDER=fake, which needs no keys and no network.

# --- provider: cloud | local | fake ---------------------------------
RAG_PROVIDER=cloud

# --- cloud (OpenAI-compatible) --------------------------------------
RAG_CLOUD_API_KEY=sk-...
RAG_CLOUD_BASE_URL=https://api.openai.com/v1
RAG_CLOUD_EMBED_MODEL=text-embedding-3-small
RAG_CLOUD_CHAT_MODEL=gpt-4o-mini

# --- local (Ollama) --------------------------------------------------
# With docker compose, the API container reaches Ollama at http://ollama:11434
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_OLLAMA_CHAT_MODEL=llama3.1:8b

# --- vector store ----------------------------------------------------
# With docker compose: http://qdrant:6333
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=documents

# --- tracing ---------------------------------------------------------
# Leave empty to disable tracing entirely — the code degrades to no-ops
# rather than failing.
RAG_LANGFUSE_HOST=http://localhost:3000
RAG_LANGFUSE_PUBLIC_KEY=
RAG_LANGFUSE_SECRET_KEY=
